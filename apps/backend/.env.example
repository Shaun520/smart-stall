# MongoDB 数据库
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=Smart-Stall

# Redis 数据库
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# 阿里云 OSS
OSS_REGION=oss-cn-shenzhen
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket

# 火山引擎
AI_API_KEY=your_ai_api_key
DOUBAO_IMAGE_UNDERSTAND_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_IMAGE_GENERATE_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
DOUBAO_VIDEO_GENERATE_API_URL=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks

DEEPSEEK_TALK_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses

# 博查AI--图片搜索API
BOCHA_IMAGE_SEARCH_API_URL=https://api.bochaai.com/v1/web-search
BOCHA_IMAGE_SEARCH_API_KEY=your_bocha_api_key

# 阿里云--短信服务
ALIYUN_SMS_BASE_URL=https://jumsendsms.market.alicloudapi.com
ALIYUN_SMS_APP_CODE=your_app_code
ALIYUN_SMS_TEMPLATE_ID=JM1000372
ALIYUN_SMS_CODE_EXPIRE_TIME=30000

# 百度云--人脸识别 / 语音识别 / 语音合成
BAIDU_FACE_BASE_URL=https://aip.baidubce.com/rest/2.0/face/v3
BAIDU_FACE_ACCESS_TOKEN=your_face_access_token
BAIDU_VOICE_BASE_URL=http://vop.baidu.com/server_api
BAIDU_VOICE_ACCESS_TOKEN=your_voice_access_token
BAIDU_TTS_BASE_URL=https://tsn.baidu.com/text2audio